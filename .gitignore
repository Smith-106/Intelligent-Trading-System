# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/*
!dist/*.sha256
!dist/SHA256SUMS.txt
!dist/release-manifest.json
build/
*.egg

# Virtual environments
.venv/
venv/
env/

# Data files (large, not tracked)
data/parquet/
data/duckdb/*.duckdb
data/duckdb/*.wal

# Config with secrets
.env
.env.local
# Private keys / certs — never commit (ISS-015). A misplaced key would be
# pushed otherwise; broaden beyond .env to cover TLS/SSH/API key material.
*.key
*.pem
*.p12
*.pfx
*.crt
*.keystore
secrets.yml
secrets.yaml
id_rsa
id_ed25519
*_rsa
*_ed25519

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Testing
.coverage
htmlcov/
.pytest_cache/

# MyPy
.mypy_cache/

# Ruff
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# Docker
docker/redis_data/
docker/grafana_data/
.venv/

# Maestro / Odyssey workflow runtime state.
# Scratch probe scripts and live session state are local-only — they should
# not be tracked. (Historical committed sessions under .workflow/.maestro/
# are left tracked for resume-from-git; only forward-going clutter is ignored.)
.workflow/scratch/
.workflow/sessions/
.workflow/.team/
.workflow/.maestro/*/status.json
.workflow/.backups/
.workflow/.trash/
.workflow/issues/.backups/
*.pid

# MaestroGraph / maestro knowledge-tool local indices and caches.
# Machine-specific, large, and fully rebuildable — never track.
.workflow/kg/
.workflow/embedding-index.bin
.workflow/embedding.zvec/
.workflow/search-cache.json
.workflow/search-daemon.json

# Frontend (React + Vite)
frontend/node_modules/
quantflow/web/static/dist/

# Temporary files and outputs
temp_output.txt
outputs/
artifacts/
screenshots/
*-p
no/

# Runtime validation datasets & reports (rebuildable via scripts/)
data/spot_perp_real/
data/s4_verify/
.venv_old/
data/paper_replay/
.pytest_tmp/
.pi/
data/rdagent_work/
data/s3_verify/
data/live_evidence/
# Local smart-search evidence dumps
tmpsmart-search-evidence*.json
# Paper-replay research outputs (large/local)
# Station local history
data/station_history/
# Pytest temp root used on Windows
# Maestro embedding / wiki runtime indexes (regenerable)
.workflow/embedding.zvec*
.workflow/wiki-index.json
.workflow/spec-analytics.jsonl
.workflow/state.json
.workflow/artifacts/p0-baseline/
