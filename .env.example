# QuantFlow Environment Configuration
# Copy this file to .env and fill in your values

# OKX API Credentials
OKX_API_KEY=
OKX_SECRET=
OKX_PASSPHRASE=
OKX_SANDBOX=true

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Telegram Alerts (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# DuckDB
DUCKDB_PATH=data/quantflow.duckdb

# Parquet Data
PARQUET_PATH=data/parquet
