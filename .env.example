# QuantFlow Environment Configuration
# Copy this file to .env and fill in your values.
# REV-024: rewritten against an exhaustive os.environ audit — the previous
# version listed 6 ghost variables the code never read (REDIS_HOST/PORT/DB/
# PASSWORD, OKX_SANDBOX, DUCKDB_PATH, PARQUET_PATH) while omitting every
# variable docker compose fail-fasts on.

# --- OKX API Credentials (required for sandbox/live trading) ---------------
# Consumed by cli/main.py and web/session_manager.py. Sandbox/live mode is
# governed by data.sandbox in config YAML (or QUANTFLOW_DATA__SANDBOX),
# NOT by an environment variable.
OKX_API_KEY=
OKX_SECRET=
OKX_PASSPHRASE=

# --- Web Station security (optional but recommended when exposed) ----------
# Bearer token required for mutation endpoints when set (web/security.py).
QUANTFLOW_STATION_TOKEN=
# Comma/space-separated reverse-proxy peer IPs allowed to set X-Forwarded-For
# (web/rate_limit.py). Leave empty unless running behind a trusted proxy.
STATION_TRUSTED_PROXIES=
# Audit-trail signature operator id (session_manager.py).
QUANTFLOW_OPERATOR_ID=

# --- Reconciliation audit signing -------------------------------------------
# Without this the reconciliation audit trail stays UNSIGNED (with a warning).
QUANTFLOW_AUDIT_HMAC_KEY=

# --- Telegram Alerts (optional) ---------------------------------------------
# Read by monitoring/sink.py as a fallback when config alert_channels is
# empty (the default — tokens must not live in tracked YAML).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Logging (Station serve path only) --------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Docker compose (REQUIRED if you use docker/docker-compose.yaml) --------
# compose fail-fasts with ${VAR:?} when these are missing.
GRAFANA_ADMIN_PASSWORD=
QUANTFLOW_REDIS_PASSWORD=
QUANTFLOW_HOST_PORT=18000

# --- Config overrides --------------------------------------------------------
# Any AppConfig field can be overridden via QUANTFLOW_<SECTION>__<FIELD>
# nested-key syntax, e.g.:
#   QUANTFLOW_DATA__REDIS_URL=redis://:pass@localhost:6379/0
#   QUANTFLOW_RISK__CVAR_LIMIT=-0.04
