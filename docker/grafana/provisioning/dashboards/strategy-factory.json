{
  "title": "QuantFlow Strategy Factory",
  "uid": "quantflow-strategy-factory",
  "schemaVersion": 39,
  "tags": ["quantflow", "strategy-factory", "s4"],
  "timezone": "utc",
  "time": { "from": "now-7d", "to": "now" },
  "refresh": "30s",
  "panels": [
    {
      "title": "Strategy PnL (by strategy_id)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "quantflow_strategy_pnl", "legendFormat": "{{strategy_id}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "currencyUSD" }, "overrides": [] }
    },
    {
      "title": "Strategy Budget Utilization",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "quantflow_strategy_budget_utilization", "legendFormat": "{{strategy_id}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "max": 1.0,
          "min": 0.0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.7 },
              { "color": "red", "value": 0.95 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "title": "Signals by Strategy (rate)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "expr": "rate(quantflow_signals_generated_total[5m])", "legendFormat": "{{strategy_id}} {{direction}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }
    },
    {
      "title": "Orders by Strategy (rate)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "rate(quantflow_orders_total[5m])", "legendFormat": "{{strategy_id}} {{side}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }
    },
    {
      "title": "Model Registry Decisions",
      "type": "stat",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 16 },
      "targets": [
        { "expr": "count(quantflow_strategy_pnl)", "legendFormat": "active strategies", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "none" },
        "overrides": []
      }
    }
  ]
}
