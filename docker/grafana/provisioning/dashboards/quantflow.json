{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "title": "Portfolio Value",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "quantflow_portfolio_value",
          "legendFormat": "Portfolio Value",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "currencyUSD" },
        "overrides": []
      }
    },
    {
      "title": "Drawdown",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "quantflow_portfolio_drawdown",
          "legendFormat": "Drawdown",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percentunit" },
        "overrides": []
      }
    },
    {
      "title": "Open Positions",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 8 },
      "targets": [
        { "expr": "quantflow_positions_count", "refId": "A" }
      ]
    },
    {
      "title": "Orders Total",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 6, "y": 8 },
      "targets": [
        {
          "expr": "rate(quantflow_orders_total[5m])",
          "legendFormat": "{{symbol}} {{side}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Risk Events",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "rate(quantflow_risk_events_total[5m])",
          "legendFormat": "{{event_type}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Signals Generated",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "rate(quantflow_signals_generated_total[5m])",
          "legendFormat": "{{strategy_id}}",
          "refId": "A"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["quantflow"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "title": "QuantFlow Trading Dashboard",
  "uid": "quantflow-main"
}