  "implementation": [
    {
      "step": 1,
      "action": "创建 quantflow/strategy/templates/ml_ensemble.py",
      "details": {
        "class": "MLEnsembleStrategy(StrategyBase)",
        "init_params": {
          "prediction_threshold": 0.6,
          "meta_label_threshold": 0.5,
          "lookback_period": 60,
          "retrain_interval": 30,
          "model_type": "random_forest",
          "n_estimators": 100,
          "max_depth": 5,
          "feature_columns": ["rsi_14", "macd_hist", "atr_14", "bb_width", "volume_ratio", "momentum_20", "roc_10"]
        },
        "feature_extraction_logic": [
          "1. 从df中提取feature_columns指定的列作为特征矩阵X",
          "2. 如果df中缺少某些特征列，用IndicatorEngine计算（或跳过）",
          "3. 处理NaN：forward fill + backward fill + fillna(0)",
          "4. 标准化：使用StandardScaler（训练时fit，推理时transform）"
        ],
        "train_logic": [
          "1. 提取特征矩阵X",
          "2. 如果labels为None，使用compute_meta_labels生成标签",
          "3. compute_meta_labels: 用base策略(如trend_following)的entries/exits作为base信号，计算base信号盈亏作为meta-label",
          "4. 训练sklearn模型（RandomForestClassifier或GradientBoostingClassifier）",
          "5. 保存模型到self._model，保存scaler到self._scaler",
          "6. 返回训练指标dict（accuracy, precision, recall, f1）"
        ],
        "predict_logic": [
          "1. 提取特征矩阵X",
          "2. 使用self._scaler.transform(X)",
          "3. 使用self._model.predict_proba(X)",
          "4. 返回预测概率Series"
        ],
        "generate_signals_logic": [
          "1. 如果self._model为None（未训练），返回全False",
          "2. 调用predict(df)获取预测概率",
          "3. entries = (predict_proba > self._prediction_threshold)",
          "4. exits = (predict_proba < (1 - self._prediction_threshold)) — 预测反转",
          "5. 如果启用meta_label：用meta_label过滤entries（meta_label==1才入场）",
          "6. 返回entries, exits"
        ],
        "on_bar_logic": "累积Bar，每retrain_interval根K线重新训练模型（可选），调用generate_signals后emit_signal",
        "get_required_indicators_return": [
          "{\"name\": \"rsi\", \"params\": {\"period\": 14}}",
          "{\"name\": \"macd\", \"params\": {\"fast\": 12, \"slow\": 26, \"signal\": 9}}",
          "{\"name\": \"atr\", \"params\": {\"period\": 14}}",
          "{\"name\": \"bb\", \"params\": {\"period\": 20, \"std\": 2.0}}"
        ],
        "imports": [
          "from sklearn.ensemble import RandomForestClassifier, GradientBoostingClassifier",
          "from sklearn.preprocessing import StandardScaler",
          "from sklearn.model_selection import TimeSeriesSplit",
          "import joblib  # 模型序列化"
        ]
      }
