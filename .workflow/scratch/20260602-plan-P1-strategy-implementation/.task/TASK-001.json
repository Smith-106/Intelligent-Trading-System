  "implementation": [
    {
      "step": 1,
      "action": "创建 quantflow/strategy/templates/volatility_breakout.py",
      "details": {
        "class": "VolatilityBreakoutStrategy(StrategyBase)",
        "init_params": {
          "atr_period": 14,
          "atr_threshold": 1.5,
          "bb_period": 20,
          "bb_std": 2.0,
          "keltner_ema_period": 20,
          "keltner_atr_period": 10,
          "keltner_multiplier": 2.0,
          "volume_period": 20,
          "volume_threshold": 1.5,
          "atr_shrink_exit": 0.7,
          "bb_middle_exit": true
        },
        "generate_signals_logic": [
          "1. 计算 ATR = atr(high, low, close, atr_period)",
          "2. 计算 ATR_MA = ATR.rolling(atr_period*2).mean()",
          "3. 计算 BB = bollinger_bands(close, bb_period, bb_std)",
          "4. 计算 BB_Width = (bb_upper - bb_lower) / bb_middle",
          "5. 计算 BB_Width_MA = BB_Width.rolling(bb_period).mean()",
          "6. 计算 KC = keltner_channel(high, low, close, keltner_ema_period, keltner_atr_period, keltner_multiplier)",
          "7. 计算 squeeze = (bb_lower > kc_lower) & (bb_upper < kc_upper) — 低波状态",
          "8. 计算 vol_ma = volume.rolling(volume_period).mean()",
          "9. entries_long = (ATR > ATR_MA * atr_threshold) & (BB_Width > BB_Width_MA) & (close > bb_upper) & (volume > vol_ma * volume_threshold) & squeeze.shift(1)",
          "10. entries_short = (ATR > ATR_MA * atr_threshold) & (BB_Width > BB_Width_MA) & (close < bb_lower) & (volume > vol_ma * volume_threshold) & squeeze.shift(1)",
          "11. entries = entries_long | entries_short",
          "12. exits = (ATR < ATR_MA * atr_shrink_exit) | (close > bb_middle if bb_middle_exit) | (close < bb_middle if bb_middle_exit)"
        ],
        "on_bar_logic": "复用trend_following.py的_bars_to_df模式，累积Bar到self._bars，调用generate_signals后emit_signal",
        "get_required_indicators_return": [
          "{\"name\": \"atr\", \"params\": {\"period\": self._atr_period}}",
          "{\"name\": \"bb\", \"params\": {\"period\": self._bb_period, \"std\": self._bb_std}}",
          "{\"name\": \"keltner\", \"params\": {\"ema_period\": self._keltner_ema_period, \"atr_period\": self._keltner_atr_period, \"multiplier\": self._keltner_multiplier}}"
        ]
      }
    },
