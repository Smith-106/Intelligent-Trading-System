  "project_version": "0.1.3",
  "last_updated": "2026-07-28T00:00:00Z",
  "rebuild_source": "manage-codebase-rebuild (--skip-kg)",
  "overview": "Personal Crypto quantitative trading system (OKX) with six-layer architecture (L1 data -> L6 monitoring), self-built event-driven TradingSession engine, anti-overfitting validation pipeline (CPCV+DSR+PBO+WFO), and QuantFlow Station web UI. Phase 1/2/3 complete.",
  "features": [
    {
      "id": "FT-001",
      "name": "Strategies",
      "status": "active",
      "requirement_ids": [],
      "component_ids": [
        "TC-003"
      ],
      "phase": "Phase 1/2 complete (7 strategies)",
      "description": "7 strategies via StrategyBase dual-mode API (generate_signals vectorized + on_bar incremental): trend_following, mean_reversion, elliott_wave (rule engine), volatility_breakout (P1), funding_rate (P2), momentum_rotation (P3), ml_ensemble (P4). YAML-driven via strategy/catalog.py factory."
    },
    {
      "id": "FT-002",
      "name": "CLI",
      "status": "active",
      "requirement_ids": [],
      "component_ids": [
        "TC-008"
      ],
      "phase": "Phase 1 complete",
      "description": "Typer + Rich CLI with 9 commands: download, research, optimize, validate, run, benchmark, ai (rdagent), station, status. Entry point: quantflow.cli.main:app."
    },
    {
      "id": "FT-003",
      "name": "Research Pipeline",
      "status": "active",
      "requirement_ids": [],
      "component_ids": [
        "TC-003"
      ],
      "phase": "Phase 1 complete",
      "description": "VectorBT-replaced pure pandas/numpy backtest (BacktestEngine) + Optuna optimization (bayesian/cmaes/grid) + report generation. BacktestEngine (renamed from VectorBTEngine) — no VectorBT dependency (Py3.14+ numba incompat)."
    },
    {
      "id": "FT-004",
      "name": "Anti-Overfitting Validation",
      "status": "active",
      "requirement_ids": [],
      "component_ids": [
        "TC-003"
      ],
      "phase": "Phase 2 complete",
      "description": "CPCV (PBO<0.5) + DSR (>0.95) + PBO + WFO (OOS eff>50%, rolling+anchored) + GO/NO-GO gate. Triple-barrier labeling, min TRL, signal quality metrics. Each stage accepts signal_fn + param_space for true OOS re-optimization."
    },
    {
      "id": "FT-005",
      "name": "Execution",
      "status": "active",
      "requirement_ids": [],
      "component_ids": [
        "TC-005"
      ],
      "phase": "Phase 3 complete",
      "description": "Three modes: paper (PaperGateway) / sandbox (OKX testnet) / live (OKX). GatewayBase ABC, ExecutionEngine routes + emits ORDER/FILL events, OrderManager timeout tracking, KillSwitch emergency flatten. OKX creds from env vars only."
    },
    {
      "id": "FT-006",
      "name": "Risk Controls",
      "status": "active",
      "requirement_ids": [],
      "component_ids": [
        "TC-004"
      ],
      "phase": "Phase 2 complete",
      "description": "RiskEngine 7-check short-circuit pipeline: position_limit -> portfolio_limit -> strategy_budget -> daily_loss -> weekly_loss -> drawdown -> VaR. Half-Kelly position sizing, VaR/CVaR, drawdown circuit breaker, KillSwitch. ScalingPositionSizer outputs PositionRequest for RiskEngine authority."
    },
    {
      "id": "FT-007",
      "name": "Data Layer",
      "status": "active",
      "requirement_ids": [],
      "component_ids": [
        "TC-001"
      ],
      "phase": "Phase 1 complete",
      "description": "CCXT async OKX fetcher (REST+WebSocket), Parquet Hive-partitioned storage (symbol/year/month) + DuckDB zero-copy query, FeatureStore point-in-time safe (no future leak), RedisCache real-time ticker, MTFAligner multi-timeframe. clean_ohlcv + validate_no_future_leak."
    },
    {
      "id": "FT-008",
      "name": "QuantFlow Station Web UI",
      "status": "active",
      "requirement_ids": [],
      "component_ids": [
        "TC-009"
      ],
      "phase": "New (beyond CLAUDE.md)",
      "description": "aiohttp web frontend with 23 REST endpoints: overview, strategies, data (download/seed-demo/tag-source), research+history, validate+history, workbench state, monitoring, execution, session (start/stop/events/history/kill-switch). Security: same_origin_guard CSRF + Bearer auth, bind-boundary launch guard (non-loopback requires QUANTFLOW_STATION_TOKEN)."
    },
    {
      "id": "FT-009",
      "name": "Indicators (27 factors)",
      "status": "active",
      "requirement_ids": [],
      "component_ids": [
        "TC-002"
      ],
      "phase": "Phase 1 complete",
      "description": "27 registered factors (21 base + 6 Elliott Wave): trend (7), momentum (4), volatility (5), volume (5), Elliott Wave (6). FactorBase ABC + FactorRegistry. Pure pandas/numpy, no TA-Lib required (optional). MarketRegimeDetector for strategy gating."
    },
    {
      "id": "FT-010",
      "name": "AI Layer",
      "status": "partial",
      "requirement_ids": [],
      "component_ids": [
        "TC-003"
      ],
      "phase": "Phase 3 partial",
      "description": "AIFactorEngine (Meta-Labeling, expanding CV splits) + MLEnsembleStrategy active. FinBERT sentiment (SentimentAnalyzer/NewsCollector) implemented in sentiment.py with tests — but not exported from strategy/__init__ nor CLI-wired. Qlib RD-Agent: CLI skeleton wired (quantflow ai rdagent) — RDAgentRunner with dependency guard (qlib optional [ml] extra); when qlib absent prints install hint, when present runs Alpha158-style baseline factor evaluation with IC gate (blueprint E13-S1 acceptance: 5+ factors IC>0.03). Full RD-Agent LLM factor search is a future layer on top."
    }
  ],
