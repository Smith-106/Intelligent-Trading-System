{
  "mcpServers": {
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": { "GITHUB_PERSONAL_ACCESS_TOKEN": "ghp_替换为你的GitHub PAT" }
    },
    "fetch": {
      "type": "sse",
      "url": "https://mcp.api-inference.modelscope.net/mcp-server-fetch/sse"
    },
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "C:\\Users\\niko\\Desktop\\智能交易系统"]
    }
  }
}
